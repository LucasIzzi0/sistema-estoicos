# Copiá este archivo a .env y completalo. Detalle de cada variable: docs/fase-0/04-variables-de-entorno.md
# Generar secretos: openssl rand -base64 32

NODE_ENV=development
APP_ENV=development            # development | staging | production
LOG_LEVEL=info
DEFAULT_ORGANIZATION_SLUG=estoicos
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000

# Base de datos y colas
DATABASE_URL=postgresql://usuario@localhost:5432/estoicos_dev
REDIS_URL=redis://localhost:6379/0
DATABASE_URL_TEST=postgresql://usuario@localhost:5432/estoicos_test
SHADOW_DATABASE_URL=postgresql://usuario@localhost:5432/estoicos_shadow
REDIS_URL_TEST=redis://localhost:6379/1

# Seguridad (secretos)
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_PREVIOUS=
AUTH_CODE_SECRET=
INTERNAL_API_SECRET=
CLOUDFLARE_ORIGIN_SECRET=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Email (Resend). Sin API key, en desarrollo los emails se muestran en la consola.
RESEND_API_KEY=
EMAIL_FROM=Estoicos <turnos@mail.tudominio.com.ar>
EMAIL_REPLY_TO=
RESEND_WEBHOOK_SECRET=

# Mercado Pago. Sin credenciales, MP_SIMULATED=true usa un simulador (solo desarrollo).
# El token y la clave de webhooks NO van acá: los carga el dueño desde el panel y se guardan cifrados.
MP_SIMULATED=false

# WhatsApp (Fase 6, opcional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Sin número aprobado en Meta, WHATSAPP_SIMULATED=true usa un simulador (solo desarrollo).
WHATSAPP_SIMULATED=false

# Worker
WORKER_CONCURRENCY=5
QUEUE_STUCK_THRESHOLD_MINUTES=10
WORKER_HEALTH_PORT=8081

# Solo desarrollo / staging
SEED_ADMIN_EMAIL=dueno@estoicos.test
SEED_ADMIN_PASSWORD=

# Opcional
SENTRY_DSN=

{
  "name": "@estoicos/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./seed": "./src/seed/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset-test": "prisma migrate reset --force",
    "seed": "tsx src/seed/index.ts",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "18.0.4"
  },
  "devDependencies": {
    "@estoicos/config": "workspace:*",
    "argon2": "0.45.1",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "@estoicos/shared": "workspace:*"
  }
}
